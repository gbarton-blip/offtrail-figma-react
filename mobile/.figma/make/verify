#!/bin/bash
set -e

TIMEOUT=120
ELAPSED=0
URL="http://localhost:18081"

echo "Waiting for Metro bundler at $URL ..."

while [ $ELAPSED -lt $TIMEOUT ]; do
  if curl -s -o /dev/null -w "%{http_code}" "$URL" | grep -q "200\|302\|404"; then
    echo "Metro bundler is ready."
    exit 0
  fi
  sleep 2
  ELAPSED=$((ELAPSED + 2))
done

echo "Timed out after ${TIMEOUT}s waiting for Metro bundler."
exit 1
